# Pimeleon Build System - Default Configuration
# =============================================================================
# This file documents ALL configurable options with their default values.
# These defaults are used when variables are not set in .env
#
# Usage:
#   1. Copy desired variables to .env
#   2. Customize values as needed
#   3. Run build with: docker compose run --rm builder
#
# Variables are organized by category and include type, valid values,
# and which components use them.
# =============================================================================

# =============================================================================
# RASPBERRY PI CONFIGURATION
# =============================================================================

# Target Raspberry Pi model
# Type: string
# Valid: 3B+, 4B, Zero W, Zero 2 W, 5
# Used by: docker-compose.yml, build.sh, stage1-base.sh (cache naming)
PIMELEON_RPI_MODEL=3B+

# Target CPU architecture
# Type: string
# Valid: armhf (32-bit ARM), arm64 (64-bit ARM)
# Used by: debootstrap, kernel selection
# Note: Pi 3B+ uses armhf, Pi 4B can use arm64
RPI_ARCH=armhf

# Raspbian/Debian release version
# Type: string
# Valid: bullseye, bookworm, trixie
# Used by: debootstrap, APT sources, cache naming
RASPBIAN_VERSION=bookworm

# Raspbian APT mirror URL
# Type: URL
# Default mirrors:
#   - http://raspbian.raspberrypi.com/raspbian/ (official, recommended)
#   - http://mirrordirector.raspbian.org/raspbian/ (deprecated)
# Used by: stage1-base.sh, stage2-customize.sh
RASPBIAN_MIRROR=http://raspbian.raspberrypi.com/raspbian/

# =============================================================================
# IMAGE CONFIGURATION
# =============================================================================

# Output disk image size
# Type: size string
# Valid: 2G, 4G, 8G, 16G
# Used by: stage1-base.sh (image creation)
PIMELEON_IMAGE_SIZE=4G

# Image compression format
# Type: string
# Valid: xz, gzip, zstd, none
# Used by: stage4-package.sh
IMAGE_COMPRESSION=xz

# Compression level (1-9, higher = smaller but slower)
# Type: integer
# Valid: 1-9
# Used by: stage4-package.sh
IMAGE_COMPRESSION_LEVEL=6

# =============================================================================
# BUILD CONFIGURATION
# =============================================================================

# Number of parallel build jobs
# Type: integer
# Recommended: CPU cores - 2
# Used by: make commands in hostapd, kernel compilation
BUILD_PARALLEL_JOBS=4

# Maximum cache size
# Type: size string
# Used by: cache management
BUILD_CACHE_SIZE=10G

# Build timeout in seconds
# Type: integer
# Used by: docker compose, CI/CD
BUILD_TIMEOUT=3600

# Build profile (affects service selection)
# Type: string
# Valid: development, production, minimal
# Used by: Ansible playbooks
PIMELEON_PROFILE=development

# Initial password for 'pi' user
# Type: string
# Used by: stage2-customize.sh, saved to output/pi-initial-password.txt
PIMELEON_INITIAL_PASSWORD=netblox

# =============================================================================
# APT PROXY CONFIGURATION
# =============================================================================

# APT proxy server (host:port format, e.g., 192.168.76.5:3142)
# Type: host:port string
# Leave empty or commented out to disable proxy and download directly
# Used by: all build stages, Ansible tasks, pnpm
# APT_PROXY=192.168.76.5:3142

# =============================================================================
# NETWORK CONFIGURATION - WIFI AP (PRIMARY LAN)
# =============================================================================

# WiFi AP network subnet (PRIMARY interface on Pi 3B+)
# Type: CIDR notation
# Used by: Ansible network.yml, hostapd, DHCP
WIFI_NETWORK=192.168.42.0/24

# WiFi AP gateway IP (Pi's address on wlan0)
# Type: IP address
# Used by: Ansible network.yml, DHCP server
WIFI_GATEWAY=192.168.42.1

# WiFi AP SSID (network name)
# Type: string (1-32 characters)
# Used by: hostapd.conf template
WIFI_SSID=pimeleon

# WiFi AP passphrase
# Type: string (8-63 characters for WPA2/WPA3)
# Used by: hostapd.conf template
WIFI_PASSPHRASE=changeme123

# WiFi channel
# Type: integer
# Valid: 1-11 (2.4GHz), 36-165 (5GHz if supported)
# Used by: hostapd.conf template
WIFI_CHANNEL=6

# WiFi country code (for regulatory compliance)
# Type: ISO 3166-1 alpha-2
# Examples: US, GB, DE, JP, AU
# Used by: hostapd.conf template, wireless-regdb
WIFI_COUNTRY=US

# WiFi mode
# Type: string
# Valid: g (2.4GHz), a (5GHz), n (2.4/5GHz), ac (5GHz), ax (WiFi 6)
# Used by: hostapd.conf template
WIFI_MODE=g

# =============================================================================
# NETWORK CONFIGURATION - MANAGEMENT
# =============================================================================

# Management network subnet (admin access)
# Type: CIDR notation
# Used by: Ansible network.yml, SSH access rules
MGMT_NETWORK=172.16.0.0/24

# Management interface IP
# Type: IP address
# Used by: Ansible network.yml
MGMT_GATEWAY=172.16.0.1

# =============================================================================
# DOCKER TEST NETWORK (not used on actual Pi)
# =============================================================================

# The Pi's WAN interface (eth0) uses DHCP from uplink - no static config needed.
# This subnet is ONLY used by docker-compose.yml to create an isolated test
# network that simulates an upstream internet connection during QEMU testing.
# It has no effect on the generated Pi image.
# Type: CIDR notation
# Used by: docker-compose.yml (tester container network simulation)
TEST_WAN_SUBNET=10.0.1.0/24

# =============================================================================
# SERVICE PORTS
# =============================================================================

# SSH server port
# Type: integer
# Used by: sshd_config template
SSH_PORT=22

# DNSCrypt proxy port (upstream encrypted DNS)
# Type: integer
# Used by: Ansible dnscrypt-proxy configuration
DNSCRYPT_PORT=5054

# Pi-hole DNS port (local DNS)
# Type: integer
# Note: 5553 to avoid conflict with BIND on 53
# Used by: Ansible Pi-hole configuration
PIHOLE_PORT=5553

# Privoxy HTTP proxy port
# Type: integer
# Used by: Ansible privoxy configuration
PRIVOXY_PORT=8118

# Squid proxy port
# Type: integer
# Used by: Ansible squid configuration
SQUID_PORT=3128

# Tor SOCKS port
# Type: integer
# Used by: Ansible tor configuration
TOR_SOCKS_PORT=9050

# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================

# System hostname
# Type: string
# Used by: Ansible base-setup, /etc/hostname
PIMELEON_HOSTNAME=pimeleon

# System timezone
# Type: IANA timezone
# Examples: UTC, America/New_York, Europe/London, Asia/Tokyo
# Used by: Ansible base-setup, timedatectl
PIMELEON_TIMEZONE=UTC

# System locale
# Type: locale string
# Used by: Ansible base-setup, locale-gen
PIMELEON_LOCALE=en_US.UTF-8

# =============================================================================
# PIMELEON WEB UI SOURCE
# =============================================================================

# Git repository URL for the pirouter-ui monorepo
# Type: URL string
# Used by: stage2-customize.sh
PIMELEON_UI_REPO=https://gitlab.pirouter.dev/pimeleon/pirouter-ui.git

# Git branch to use for the UI source
# Type: string (branch name)
# Leave empty for auto-selection: development profile -> develop, production -> master
# Used by: stage2-customize.sh
PIMELEON_UI_BRANCH=

# GitLab personal access token for authenticated repo access
# Type: string (token)
# Required for internal/private repos
# Used by: stage2-customize.sh
PIMELEON_UI_BUILD_TOKEN=

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================

# Test execution timeout
# Type: integer (seconds)
TEST_TIMEOUT=3600

# Number of simulated clients for basic tests
# Type: integer
TEST_CLIENT_COUNT=5

# Number of clients for stress testing
# Type: integer
TEST_STRESS_CLIENTS=50

# Bandwidth limit for testing
# Type: bandwidth string
TEST_BANDWIDTH_LIMIT=100M

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Enable secure boot signing
# Type: boolean (true/false)
ENABLE_SECURE_BOOT=false

# Enable image signing with GPG
# Type: boolean (true/false)
ENABLE_IMAGE_SIGNING=true

# GPG key ID for image signing
# Type: string (GPG key ID)
# Leave empty to skip signing
GPG_KEY_ID=

# =============================================================================
# CI/CD CONFIGURATION
# =============================================================================

# Artifact retention period in days
# Type: integer
ARTIFACT_RETENTION_DAYS=90

# Log retention period in days
# Type: integer
LOG_RETENTION_DAYS=30

# Container registry for publishing images
# Type: registry URL
PUBLISH_REGISTRY=

# Cloud storage bucket for artifacts
# Type: bucket name
PUBLISH_BUCKET=

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================

# Enable Docker BuildKit
# Type: integer (0 or 1)
DOCKER_BUILDKIT=1

# Debian frontend mode
# Type: string
# Valid: noninteractive, readline, dialog
DEBIAN_FRONTEND=noninteractive
