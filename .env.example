# Pimeleon Build System Environment Configuration
# Copy this file to .env and customize as needed

# APT Cache Configuration (for faster builds)
# Set APT_CACHE_SERVER to your TrueNAS or apt-cacher-ng server IP
# Leave empty to disable APT cache
APT_CACHE_SERVER=192.168.76.5
APT_CACHE_PORT=3142

# Build Configuration
RPI_MODEL=3B+
IMAGE_SIZE=4G
RASPBIAN_VERSION=buster
RASPBIAN_MIRROR=http://raspbian.raspberrypi.org/raspbian/

# Build Options
DOCKER_BUILDKIT=1