# Pimeleon Build System Environment Configuration
# Copy this file to .env and customize as needed

# APT Cache Configuration (for faster builds)
# Set APT_CACHE_SERVER to your TrueNAS or apt-cacher-ng server IP
# Leave empty to disable APT cache
APT_CACHE_SERVER=192.168.76.5
APT_CACHE_PORT=3142

# Build Configuration
RPI_MODEL=3B+
IMAGE_SIZE=4G
RASPBIAN_VERSION=buster
RASPBIAN_MIRROR=http://raspbian.raspberrypi.org/raspbian/

# Network Configuration
# WAN_MAC: Original MAC address of eth0 (for MAC matching in .link file)
# WAN_SPOOF_MAC: MAC address to spoof on WAN interface (optional)
WAN_MAC=
WAN_SPOOF_MAC=

# Build Options
DOCKER_BUILDKIT=1

# Pimeleon Web UI Source
# Repository URL and branch for the Pimeleon web UI monorepo
PIMELEON_UI_REPO=https://gitlab.pirouter.dev/pimeleon/pirouter-ui.git
# Leave PIMELEON_UI_BRANCH empty for auto-selection based on PIMELEON_PROFILE
# development profile -> develop branch, production/staging -> master branch
PIMELEON_UI_BRANCH=
# GitLab token for authenticated access (optional)
PIMELEON_UI_BUILD_TOKEN=
