# Pimeleon Build System Environment Configuration
# Copy this file to .env and customize as needed

# APT Proxy Configuration (for faster builds)
# Set APT_PROXY to your apt-cacher-ng server (host:port)
# Leave empty to disable APT proxy
# APT_PROXY=192.168.76.5:3142

# Build Configuration
RPI_MODEL=3B+
IMAGE_SIZE=4G
RASPBIAN_VERSION=buster
RASPBIAN_MIRROR=http://raspbian.raspberrypi.org/raspbian/

# Build Options
DOCKER_BUILDKIT=1
