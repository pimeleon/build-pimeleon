# Pi-hole configuration file (v6)
# Generated by Pimeleon build system
# Web interface DISABLED - managed via pirouter API

[dns]
  # Forward to dnscrypt-proxy
  upstreams = ["127.0.0.1#{{ dnscrypt_port | default(5054) }}"]

  # Listen on non-standard port (bind9 forwards here)
  port = {{ pihole_port | default(5553) }}

  # CNAME inspection for better blocking
  CNAMEdeepInspect = true

  # Block encrypted SNI
  blockESNI = true

  # Show DNSSEC queries
  showDNSSEC = true

  # Analyze all query types
  analyzeOnlyAandAAAA = false

  # PTR response
  piholePTR = "PI.HOLE"

  # Rate limiting
  rateLimit.count = 1000
  rateLimit.interval = 60

  [dns.blocking]
    active = true
    mode = "NULL"

  [dns.cache]
    size = 10000

[dhcp]
  # DHCP disabled - isc-dhcp-server handles this
  active = false

[webserver]
  # Web interface DISABLED
  port = ""

  [webserver.api]
    password = ""

[database]
  DBimport = true

[misc]
  # Load additional dnsmasq config from /etc/dnsmasq.d/
  etc_dnsmasq_d = true

  # Privacy level (0 = show everything)
  privacylevel = 0

[files]
  log.dnsmasq = "/var/log/pihole/pihole.log"
  log.ftl = "/var/log/pihole/FTL.log"
  database = "/etc/pihole/pihole-FTL.db"
