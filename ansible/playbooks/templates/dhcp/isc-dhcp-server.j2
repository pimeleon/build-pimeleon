# Defaults for isc-dhcp-server
# Generated by Pimeleon build system

# Path to dhcpd's config file
DHCPDv4_CONF=/etc/dhcp/dhcpd.conf

# Path to dhcpd's PID file
DHCPDv4_PID=/var/run/dhcpd.pid

# Interfaces to serve DHCP on
INTERFACESv4="{{ lan_interface }}{% if wifi_interface is defined %} {{ wifi_interface }}{% endif %}"

# IPv6 disabled (using link-local only on LAN)
INTERFACESv6=""
