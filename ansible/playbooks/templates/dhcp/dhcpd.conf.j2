# ISC DHCP Server Configuration
# Generated by Pimeleon build system

# Include RNDC key for DDNS
include "/etc/dhcp/rndc.key";

# Global options
option domain-name "{{ dns_domain | default('pimeleon.local') }}";
option domain-name-servers {{ lan_ip }};

# DDNS configuration
ddns-updates on;
ddns-update-style interim;
ddns-rev-domainname "in-addr.arpa.";
ddns-dual-stack-mixed-mode true;
do-forward-updates on;
update-optimization true;
update-conflict-detection true;
update-static-leases on;
use-host-decl-names on;
allow client-updates;

# Global settings
default-lease-time {{ dhcp_default_lease | default(86400) }};
max-lease-time {{ dhcp_max_lease | default(604800) }};
authoritative;
allow unknown-clients;

# DNS zones for DDNS
zone {{ dns_domain | default('pimeleon.local') }}. {
    primary 127.0.0.1;
    key rndc-key;
}

zone {{ lan_network | regex_replace('^(\\d+)\\.(\\d+)\\.(\\d+)\\..*', '\\3.\\2.\\1') }}.in-addr.arpa. {
    primary 127.0.0.1;
    key rndc-key;
}

zone {{ wifi_ap_network | regex_replace('^(\\d+)\\.(\\d+)\\.(\\d+)\\..*', '\\3.\\2.\\1') }}.in-addr.arpa. {
    primary 127.0.0.1;
    key rndc-key;
}

# LAN subnet ({{ lan_interface }})
subnet {{ lan_network | regex_replace('/\\d+$', '') | regex_replace('\\.\\d+$', '.0') }} netmask {{ lan_netmask }} {
    option routers {{ lan_ip }};
    option domain-name-servers {{ lan_ip }};
    option subnet-mask {{ lan_netmask }};
    option ntp-servers {{ lan_ip }};
    range {{ dhcp_range_start }} {{ dhcp_range_end }};
    interface {{ lan_interface }};
}

{% if wifi_interface is defined %}
# WiFi subnet ({{ wifi_interface }})
subnet {{ wifi_ap_network | regex_replace('/\\d+$', '') | regex_replace('\\.\\d+$', '.0') }} netmask {{ wifi_ap_netmask }} {
    option routers {{ wifi_ap_ip }};
    option domain-name-servers {{ wifi_ap_ip }};
    option subnet-mask {{ wifi_ap_netmask }};
    option ntp-servers {{ wifi_ap_ip }};
    range {{ wifi_dhcp_range_start }} {{ wifi_dhcp_range_end }};
    interface {{ wifi_interface }};
    # Shorter lease for WiFi clients
    default-lease-time {{ wifi_dhcp_lease | default(3600) }};
}
{% endif %}

