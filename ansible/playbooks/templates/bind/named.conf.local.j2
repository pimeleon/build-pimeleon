// BIND9 local zones configuration
// Generated by Pimeleon build system

// Include RNDC key for DDNS updates
include "/etc/bind/rndc.key";

// Local domain zone
zone "{{ dns_domain | default('pimeleon.local') }}" {
    type master;
    file "/var/lib/bind/{{ dns_domain | default('pimeleon.local') }}.zone";
    allow-update { key rndc-key; };
    check-names ignore;
};

// Reverse zone for LAN (192.168.76.x)
zone "{{ lan_network | regex_replace('^(\\d+)\\.(\\d+)\\.(\\d+)\\..*', '\\3.\\2.\\1') }}.in-addr.arpa" {
    type master;
    file "/var/lib/bind/{{ lan_network | regex_replace('^(\\d+)\\.(\\d+)\\.(\\d+)\\..*', '\\3.\\2.\\1') }}.rev";
    allow-update { key rndc-key; };
    check-names ignore;
};

// Reverse zone for WiFi (192.168.77.x)
zone "{{ wifi_ap_network | regex_replace('^(\\d+)\\.(\\d+)\\.(\\d+)\\..*', '\\3.\\2.\\1') }}.in-addr.arpa" {
    type master;
    file "/var/lib/bind/{{ wifi_ap_network | regex_replace('^(\\d+)\\.(\\d+)\\.(\\d+)\\..*', '\\3.\\2.\\1') }}.rev";
    allow-update { key rndc-key; };
    check-names ignore;
};
