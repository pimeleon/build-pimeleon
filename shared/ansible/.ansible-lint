---
# Ansible-lint configuration for Pimeleon project

# Define file kinds to help ansible-lint identify file types correctly
kinds:
  - tasks: "playbooks/tasks/*-setup.yml"
  - playbook: "playbooks/main.yml"

# Skip rules that are not applicable
skip_list:
  - name[casing]  # Allow lowercase handler names temporarily

# Enable offline mode (no internet required for docs)
offline: true

# Exclude paths
exclude_paths:
  - .cache/
  - .git/
  - roles/  # Empty directory

# Use specific profile
profile: production
