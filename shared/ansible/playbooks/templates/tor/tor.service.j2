# {{ ansible_managed }}
# Tor systemd service for Pimeleon router

[Unit]
Description=Anonymizing overlay network for TCP
Documentation=man:tor(1) https://www.torproject.org/docs/documentation.html
After=network-online.target nss-lookup.target
Wants=network-online.target
PartOf=tor-master.service
ReloadPropagatedFrom=tor-master.service

[Service]
Type=notify
NotifyAccess=all
User=tor
Group=tor
ExecStartPre=/usr/local/bin/tor --verify-config -f /etc/tor/torrc
ExecStart=/usr/local/bin/tor -f /etc/tor/torrc
ExecReload=/bin/kill -HUP ${MAINPID}
TimeoutStartSec=300
TimeoutStopSec=60
Restart=on-failure
RestartSec=10
WatchdogSec=60

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/tor /var/log/tor /var/run/tor
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_NET_BIND_SERVICE CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Security sandbox
SeccompFilter=@system-service
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes

[Install]
WantedBy=multi-user.target
