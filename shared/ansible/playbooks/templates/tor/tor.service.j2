# {{ ansible_managed }}
# Tor systemd drop-in override for Pimeleon router
# Drop-ins extend the package unit - ExecStart must be cleared before resetting

[Unit]
After=network-online.target nss-lookup.target
Wants=network-online.target nss-lookup.target

[Service]
User=debian-tor
Group=debian-tor
# Clear inherited ExecStartPre and ExecStart from package unit before overriding
ExecStartPre=
ExecStartPre=/usr/bin/tor --verify-config -f /etc/tor/torrc
ExecStart=
ExecStart=/usr/bin/tor -f /etc/tor/torrc
TimeoutStartSec=300
TimeoutStopSec=60
WatchdogSec=60

# Additional hardening not in package unit
SystemCallFilter=@system-service
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
