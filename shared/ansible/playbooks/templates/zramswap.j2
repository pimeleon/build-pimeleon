# Pimeleon zram swap configuration
# Compressed RAM swap for better performance on low-memory Pi devices

# Compression algorithm: lz4 for speed, zstd for ratio
# lz4 is faster and recommended for Pi
ALGO=lz4

# Number of zram devices (default: number of CPUs)
# Single device is simpler and sufficient for Pi
NRDEVICES=1

# Percentage of RAM to use for zram swap
# 25% is conservative, 50% more aggressive
PERCENT={{ zram_percent | default(25) }}

# Or use fixed size (overrides PERCENT if set)
#SIZE=256M

# Swap priority (higher = preferred over disk swap)
# 100 ensures zram is used before any disk-based swap
PRIORITY=100
