# ============================================================================
# Cursor Configuration
# ============================================================================

# Steady underscore cursor (\e[4 q), always visible (\e[?25h)
printf '\e[?25h\e[4 q'

_fix_cursor() {
    printf '\e[?25h\e[4 q'
}
precmd_functions+=(_fix_cursor)
zle_line_init_functions+=(_fix_cursor)

# ============================================================================
# Login Actions
# ============================================================================

# Show MOTD banner (zsh does not source /etc/profile.d automatically)
[[ -o login ]] && [[ -f /etc/profile.d/pimeleon-motd.sh ]] && source /etc/profile.d/pimeleon-motd.sh

# Show service status in interactive non-tmux shells
if [[ $- == *i* ]] && [[ -z "$TMUX" ]]; then
    startup
    echo ""
    echo "  Type 'pim-help' for all Pimeleon commands"
fi
