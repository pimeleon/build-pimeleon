# Pimeleon Zsh Configuration
# Generated by Pimeleon build system

# ============================================================================
# Oh My Zsh Configuration
# ============================================================================

# Path to oh-my-zsh installation
export ZSH="/home/pim/.oh-my-zsh"

# Theme
ZSH_THEME="robbyrussell"

# Plugins
plugins=(
    git
    sudo
    history
    colored-man-pages
    command-not-found
    extract
)

# Performance: disable compfix and dirty tracking for faster startup
ZSH_DISABLE_COMPFIX=true
DISABLE_UNTRACKED_FILES_DIRTY="true"

# Auto-update: disabled — cron handles it (see /etc/cron.d)
zstyle ':omz:update' mode disabled

# Source oh-my-zsh
source $ZSH/oh-my-zsh.sh

# ============================================================================
# Shell Options
# ============================================================================

setopt AUTO_CD              # cd to directory without typing cd
setopt AUTO_PUSHD           # Push directories onto the stack automatically
setopt PUSHD_IGNORE_DUPS    # No duplicate entries in pushd stack
setopt CORRECT              # Suggest corrections for mistyped commands
setopt INTERACTIVE_COMMENTS # Allow # comments in interactive shell
setopt NO_BEEP              # No terminal beeping
setopt EXTENDED_GLOB        # Extended globbing patterns

# ============================================================================
# Pimeleon Environment
# ============================================================================

# Locale and editor
export LANG=en_IE.UTF-8
export EDITOR='nano'

# Pimeleon directories (runtime variables use PIM_ prefix)
export PIM_APPS="/opt/pimeleon"

# Network interfaces
export WIFI_IF="wlan0"
export WAN_IF="eth0"

# ============================================================================
# History Settings
# ============================================================================

HISTSIZE=10000
SAVEHIST=10000
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_FIND_NO_DUPS
setopt HIST_REDUCE_BLANKS
setopt SHARE_HISTORY
setopt APPEND_HISTORY
setopt INC_APPEND_HISTORY
setopt EXTENDED_HISTORY
setopt HIST_EXPIRE_DUPS_FIRST

# ============================================================================
# Color Support
# ============================================================================

if [ -x /usr/bin/dircolors ]; then
    eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

# ============================================================================
# Completion Settings
# ============================================================================

zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'  # Case-insensitive
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path ~/.zsh/cache

# ============================================================================
# Aliases - General
# ============================================================================

alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias ..='cd ..'
alias ...='cd ../..'
alias df='df -h -BM'
alias diff='diff -ba'

# Safety aliases
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

# System info
alias meminfo='free -h'
alias diskinfo='df -h'
alias show-os-info='lsb_release -a'
alias show-kernel-info='uname -a'
alias temp='get_cpu_temp'
alias myip='curl -s http://checkip.amazonaws.com'
alias localip='hostname -I | cut -d" " -f1'
alias list-largest-dirs='sudo du -h / --max-depth=1 --exclude=/proc --exclude=/sys --exclude=/dev --exclude=/run 2>/dev/null | sort -hr | head -10'

# ============================================================================
# Aliases - Pimeleon Services
# ============================================================================

alias pim-status='systemctl status pimeleon-api'
alias pim-logs='journalctl -u pimeleon-api -f'
alias net-status='networkctl status'
alias wifi-status='hostapd_cli status'
alias wifi-clients='sudo iw dev wlan0 station dump'

# Service management
alias pim-restart='sudo systemctl restart pimeleon-api'
alias wifi-restart='sudo systemctl restart hostapd'
alias dns-restart='sudo systemctl restart bind9'
alias dhcp-restart='sudo systemctl restart isc-dhcp-server'
alias hostapd-status='sudo systemctl status hostapd'

# Privacy services
alias privoxy-restart='sudo systemctl restart privoxy'
alias tor-restart='sudo systemctl restart tor'
alias squid-restart='sudo systemctl restart squid'
alias pihole-restart='sudo systemctl restart pihole'

# ============================================================================
# Aliases - DNS
# ============================================================================

alias dns-flush='sudo rndc flush && echo "DNS cache flushed"'
alias dns-cache-size='sudo rndc stats && tail -20 /var/cache/bind/stats'

# ============================================================================
# Aliases - Logs
# ============================================================================

alias syslog='journalctl -f'
alias authlog='journalctl -u ssh -f'
alias jnl='sudo journalctl -fe'
alias auth-log='sudo tail -f /var/log/auth.log'
alias privoxy-log='sudo journalctl -u privoxy -f'
alias squid-log='sudo tail -f /var/log/squid/access.log'
alias pihole-log='sudo tail -f /var/log/pihole.log'
alias tor-notices-log='sudo tail -f /var/log/tor/notices.log'

# ============================================================================
# Aliases - Network Diagnostics
# ============================================================================

alias ports='ss -tulpn'
alias connections='ss -tan'
alias routes='ip route show'
alias arp='ip neigh show'

# ============================================================================
# Aliases - Security
# ============================================================================

alias fail2ban-status='sudo fail2ban-client status'
alias fail2ban-jail='sudo fail2ban-client status sshd'
alias nft-list='sudo nft list ruleset'
alias last-logins='last -n 20'
alias ssh-sessions='who -u'

# ============================================================================
# Functions - System Monitoring
# ============================================================================

# CPU temperature with RPi-specific fallback chain
get_cpu_temp() {
    if command -v vcgencmd &>/dev/null; then
        vcgencmd measure_temp 2>/dev/null | cut -d= -f2
    elif [[ -f /sys/class/thermal/thermal_zone0/temp ]]; then
        local temp=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null)
        [[ -n "$temp" ]] && echo "$(( temp / 1000 ))°C" || echo "N/A"
    else
        echo "N/A"
    fi
}

# Quick system info
sysinfo() {
    echo "Hostname: $(hostname)"
    echo "Uptime:   $(uptime -p)"
    echo "Temp:     $(get_cpu_temp)"
    echo "Memory:   $(free -h | awk '/^Mem:/ {print $3 "/" $2}')"
    echo "Disk:     $(df -h / | awk 'NR==2 {print $3 "/" $2 " (" $5 " used)"}')"
    echo "Load:     $(awk '{print $1, $2, $3}' /proc/loadavg)"
}

# Full system dashboard
pim-dashboard() {
    echo "═══════════════════════════════════════════════════════"
    echo "  Pimeleon Status Dashboard - $(hostname)"
    echo "═══════════════════════════════════════════════════════"
    echo ""
    echo "▶ System:"
    echo "  CPU Temp: $(get_cpu_temp)"
    echo "  Memory:   $(free -h | awk '/^Mem:/ {print $3 "/" $2}')"
    echo "  Disk:     $(df -h / | awk 'NR==2 {print $3 "/" $2 " (" $5 " used)"}')"
    echo "  Swap:     $(free -h | awk '/^Swap:/ {print $3 "/" $2}')"
    echo "  Uptime:   $(uptime -p)"
    echo ""
    echo "▶ Network:"
    echo "  WAN IP:   $(curl -s --max-time 5 http://checkip.amazonaws.com 2>/dev/null || echo "N/A")"
    echo "  LAN IP:   $(hostname -I | awk '{print $1}')"
    echo ""
    echo "▶ Core Services:"
    for svc in pimeleon-api bind9 hostapd isc-dhcp-server fail2ban; do
        systemctl is-active --quiet "$svc" \
            && echo "  ✓ $svc" \
            || echo "  ✗ $svc"
    done
    echo ""
    echo "▶ Privacy Services:"
    for svc in privoxy tor squid pihole dnscrypt-proxy; do
        if systemctl cat "$svc" &>/dev/null; then
            systemctl is-active --quiet "$svc" \
                && echo "  ✓ $svc" \
                || echo "  ✗ $svc (installed, inactive)"
        fi
    done
    echo "═══════════════════════════════════════════════════════"
}

# ============================================================================
# Functions - Service Status Check (shown on login)
# ============================================================================

startup() {
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    local core=(pimeleon-api bind9 hostapd isc-dhcp-server privoxy fail2ban)
    local optional=(tor pihole squid dnscrypt-proxy)
    for svc in "${core[@]}"; do
        systemctl is-active --quiet "$svc" \
            && echo "  ✓ $svc" \
            || echo "  ✗ $svc"
    done
    for svc in "${optional[@]}"; do
        if systemctl cat "$svc" &>/dev/null; then
            systemctl is-active --quiet "$svc" \
                && echo "  ✓ $svc" \
                || echo "  ✗ $svc (inactive)"
        fi
    done
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "  $(uname -r) | $(hostname -I | awk '{print $1}') | $(get_cpu_temp)"
}

# ============================================================================
# Functions - Connected Clients
# ============================================================================

pim-clients() {
    echo "WiFi Clients:"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    sudo iw dev wlan0 station dump 2>/dev/null \
        | grep -E "Station|signal:|rx bytes:|tx bytes:" \
        | awk '/Station/{mac=$2} /signal:/{sig=$2} /rx bytes:/{rx=$3} /tx bytes:/{tx=$3;
               printf "  %-20s  sig: %-6s  rx: %-12s  tx: %s\n", mac, sig, rx, tx}'

    echo ""
    echo "ARP Table:"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    ip neigh show | grep -v FAILED

    echo ""
    echo "DHCP Leases:"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    if [[ -f /var/lib/dhcp/dhcpd.leases ]]; then
        grep "^lease" /var/lib/dhcp/dhcpd.leases | awk '{print "  " $2}' | sort -u
    else
        echo "  No lease file found"
    fi
}

# ============================================================================
# Functions - DNS
# ============================================================================

pim-dns-test() {
    local domain=${1:-google.com}
    echo "DNS test: $domain"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "Local (127.0.0.1):"
    dig @127.0.0.1 "$domain" +short
    echo -n "  Query time: "
    dig @127.0.0.1 "$domain" | awk '/Query time:/ {print $4 " ms"}'
    echo ""
    echo "Upstream (1.1.1.1):"
    dig @1.1.1.1 "$domain" +short
    echo -n "  Query time: "
    dig @1.1.1.1 "$domain" | awk '/Query time:/ {print $4 " ms"}'
}

# ============================================================================
# Functions - Security
# ============================================================================

pim-security-check() {
    echo "═══════════════════════════════════════════════════════"
    echo "  Pimeleon Security Audit"
    echo "═══════════════════════════════════════════════════════"

    echo "▶ SSH Configuration:"
    grep -q "^PermitRootLogin no" /etc/ssh/sshd_config \
        && echo "  ✓ Root login disabled" \
        || echo "  ⚠ Root login not explicitly disabled"
    grep -q "^PasswordAuthentication no" /etc/ssh/sshd_config \
        && echo "  ✓ Password auth disabled" \
        || echo "  ⚠ Password auth enabled"
    grep -q "^Port 22$" /etc/ssh/sshd_config \
        && echo "  ⚠ Using default SSH port 22" \
        || echo "  ✓ Non-standard SSH port"

    echo ""
    echo "▶ Firewall (nftables):"
    if sudo nft list ruleset &>/dev/null; then
        local chains=$(sudo nft list ruleset | grep -c "chain" || echo 0)
        echo "  ✓ nftables active ($chains chains defined)"
    else
        echo "  ⚠ nftables not responding"
    fi

    echo ""
    echo "▶ Fail2ban:"
    if systemctl is-active --quiet fail2ban; then
        echo "  ✓ Fail2ban active"
        sudo fail2ban-client status sshd 2>/dev/null \
            | grep "Currently banned" \
            | sed 's/^/  /'
    else
        echo "  ⚠ Fail2ban inactive"
    fi

    echo ""
    echo "▶ System Updates:"
    local updates
    updates=$(apt list --upgradable 2>/dev/null | grep -c upgradable)
    (( updates > 1 )) \
        && echo "  ⚠ $((updates - 1)) updates available" \
        || echo "  ✓ System up to date"

    echo ""
    echo "▶ Listening Ports:"
    ss -tulpn | grep LISTEN | awk '{print "  " $5 "\t" $7}'

    echo "═══════════════════════════════════════════════════════"
}

# ============================================================================
# Functions - Proxy Chain
# ============================================================================

pim-proxy-status() {
    echo "Proxy Chain Status:"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    if systemctl is-active --quiet squid; then
        local squid_port
        squid_port=$(grep -E "^http_port" /etc/squid/squid.conf 2>/dev/null | awk '{print $2}')
        echo "✓ Squid: running on port ${squid_port:-3128}"
    else
        echo "✗ Squid: not running"
    fi

    if systemctl is-active --quiet privoxy; then
        local privoxy_addr
        privoxy_addr=$(grep -E "^listen-address" /etc/privoxy/config 2>/dev/null | awk '{print $2}')
        echo "✓ Privoxy: running on ${privoxy_addr:-8118}"
        grep -q "^forward-socks5t" /etc/privoxy/config 2>/dev/null \
            && echo "  → forwarding to Tor" \
            || echo "  → direct connection"
    else
        echo "✗ Privoxy: not running"
    fi

    if systemctl is-active --quiet tor; then
        echo "✓ Tor: running on port 9050"
        if command -v torsocks &>/dev/null; then
            echo -n "  → exit IP: "
            torsocks curl -s --max-time 10 http://checkip.amazonaws.com 2>/dev/null \
                || echo "unable to determine"
        fi
    else
        echo "✗ Tor: not running"
    fi
}

privoxy-enable-tor() {
    echo "Enabling Tor for Privoxy..."
    if [[ ! -f /etc/privoxy/config ]]; then
        echo "Error: Privoxy config not found"
        return 1
    fi
    sudo sed -i -E \
        -e 's/(forward[[:space:]]+\/[[:space:]]+\.)/#\1/' \
        -e 's/#+(forward-socks5t)/\1/' \
        /etc/privoxy/config
    systemctl is-active --quiet tor || sudo systemctl start tor
    sudo systemctl force-reload privoxy && echo "✓ Privoxy now routes through Tor"
}

privoxy-disable-tor() {
    echo "Disabling Tor for Privoxy..."
    if [[ ! -f /etc/privoxy/config ]]; then
        echo "Error: Privoxy config not found"
        return 1
    fi
    sudo sed -i -E \
        -e 's/#+(forward[[:space:]]+\/[[:space:]]+\.)/\1/' \
        -e 's/(forward-socks5t)/#\1/' \
        /etc/privoxy/config
    sudo systemctl force-reload privoxy && echo "✓ Privoxy using direct connections"
}

# ============================================================================
# Functions - Power Management
# ============================================================================

swap-disable() {
    echo "Disabling swap (reduces SD card wear)..."
    sudo dphys-swapfile swapoff && echo "✓ Swap disabled"
}

swap-enable() {
    echo "Enabling swap..."
    sudo dphys-swapfile swapon && echo "✓ Swap enabled"
}

battery-status() {
    echo "Battery monitoring not yet implemented"
    # TODO: Add GPIO-based 18650 battery voltage monitoring
}

# ============================================================================
# Functions - Editor Wrappers (auto-backup before edit)
# ============================================================================

nano() {
    [[ -n "$1" && -f "$1" ]] && cp "$1" "$1.bak.$(date +%Y%m%d)" 2>/dev/null
    command nano "$@"
}

vim() {
    [[ -n "$1" && -f "$1" ]] && cp "$1" "$1.bak.$(date +%Y%m%d)" 2>/dev/null
    command vim "$@"
}

