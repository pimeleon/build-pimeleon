# Pimeleon Zsh Configuration
# Generated by Pimeleon build system

# Path to oh-my-zsh installation
export ZSH="/home/pim/.oh-my-zsh"

# Theme (robbyrussell is the default, agnoster is nice with powerline fonts)
ZSH_THEME="robbyrussell"

# Plugins
plugins=(
    git
    sudo
    history
    colored-man-pages
)

# Oh-my-zsh auto-update settings
zstyle ':omz:update' mode disabled  # Disabled - using cron instead

# Source oh-my-zsh
source $ZSH/oh-my-zsh.sh

# ============================================================================
# Pimeleon Environment
# ============================================================================

# Locale and editor
export LANG=en_IE.UTF-8
export EDITOR='nano'

# Pimeleon directories (runtime variables use PIM_ prefix)
export PIM_APPS="/opt/pimeleon"

# WiFi interface (always wlan0 for AP mode)
export WIFI_IF="wlan0"

# ============================================================================
# History Settings
# ============================================================================

HISTSIZE=10000
SAVEHIST=10000
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt SHARE_HISTORY
setopt APPEND_HISTORY
setopt INC_APPEND_HISTORY

# ============================================================================
# Aliases - General
# ============================================================================

alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias ..='cd ..'
alias ...='cd ../..'

# Safety aliases
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

# ============================================================================
# Aliases - Pimeleon Services
# ============================================================================

alias pim-status='systemctl status pimeleon-api'
alias pim-logs='journalctl -u pimeleon-api -f'
alias net-status='networkctl status'
alias wifi-status='hostapd_cli status'

# Quick service management
alias pim-restart='sudo systemctl restart pimeleon-api'
alias wifi-restart='sudo systemctl restart hostapd'
alias dns-restart='sudo systemctl restart bind9'
alias dhcp-restart='sudo systemctl restart isc-dhcp-server'

# Logs shortcuts
alias syslog='journalctl -f'
alias authlog='journalctl -u ssh -f'

# ============================================================================
# Aliases - Network Diagnostics
# ============================================================================

alias ports='ss -tulpn'
alias connections='ss -tan'
alias routes='ip route show'
alias arp='ip neigh show'

# ============================================================================
# Functions
# ============================================================================

# Quick system info
sysinfo() {
    echo "Hostname: $(hostname)"
    echo "Uptime:   $(uptime -p)"
    echo "Memory:   $(free -h | awk '/^Mem:/ {print $3 "/" $2}')"
    echo "Disk:     $(df -h / | awk 'NR==2 {print $3 "/" $2 " (" $5 " used)"}')"
    echo "Load:     $(cat /proc/loadavg | awk '{print $1, $2, $3}')"
}

# ============================================================================
# Cursor Configuration
# ============================================================================

# Ensure cursor is visible and set to steady underscore
# \e[?25h  - Show cursor
# \e[4 q   - Steady underscore (use 3 for blinking)
printf '\e[?25h\e[4 q'

# Ensure cursor settings persist after commands and line editing
_fix_cursor() {
    printf '\e[?25h\e[4 q'
}
precmd_functions+=(_fix_cursor)
zle_line_init_functions+=(_fix_cursor)


# Banner is displayed via /etc/profile.d/pimeleon-motd.sh for all shells
