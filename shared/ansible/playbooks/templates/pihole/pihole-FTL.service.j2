# {{ ansible_managed }}
# Pi-hole FTL systemd service (DNS sinkhole, no web interface)

[Unit]
Description=Pi-hole FTL DNS resolver
Documentation=https://docs.pi-hole.net/
After=network-online.target dnscrypt-proxy.service
Wants=network-online.target dnscrypt-proxy.service

[Service]
Type=simple
User=pihole
Group=pihole

ExecStart=/usr/local/bin/pihole-FTL no-daemon
Restart=on-failure
RestartSec=5
TimeoutStartSec=30

# File limits
LimitNOFILE=65536

# Capabilities for DNS binding and raw sockets
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN CAP_SYS_NICE CAP_CHOWN
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN CAP_SYS_NICE CAP_CHOWN

# Hardening
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=no
ReadWritePaths=/etc/pihole /var/lib/pihole /var/log/pihole /var/run/pihole

[Install]
WantedBy=multi-user.target
