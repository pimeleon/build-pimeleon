# Pi-hole FTL configuration (v6)
# Generated by Pimeleon build system
# Based on production gw config

[dns]
  # Forward to dnscrypt-proxy (encrypted upstream)
  upstreams = ["{{ dns_local }}#{{ dnscrypt_port }}"]

  # Listen on non-standard port (BIND forwards here for ad-blocking)
  port = {{ pihole_port }}

  # Listen on all interfaces
  listeningMode = "ALL"

  # Allow queries for private IP ranges (needed for local DNS)
  bogusPriv = false

  # Disable query logging (reduce SD card wear)
  queryLogging = false

  # CNAME inspection for better blocking
  CNAMEdeepInspect = true

  # Block encrypted SNI (prevents bypass)
  blockESNI = true

  # Analyze all query types (not just A/AAAA)
  analyzeOnlyAandAAAA = false

  # Rate limiting
  rateLimit.count = 1000
  rateLimit.interval = 60

  [dns.blocking]
    active = true
    mode = "NULL"

  [dns.cache]
    size = 10000

  [dns.domain]
    name = "{{ domain_name | default('pimeleon.lan') }}"

[dhcp]
  # DHCP disabled - isc-dhcp-server handles this
  active = false

[resolver]
  # Use system resolver settings
  resolveIPv4 = true
  resolveIPv6 = false

[database]
  DBimport = true
  # Reduce database writes (SD card longevity)
  DBinterval = 60.0

[webserver]
  # Web interface DISABLED - Pimeleon has its own UI
  port = ""

  [webserver.api]
    # No authentication (API disabled anyway)
    password = ""

[files]
  log.dnsmasq = "/var/log/pihole/pihole.log"
  log.ftl = "/var/log/pihole/FTL.log"
  database = "/etc/pihole/pihole-FTL.db"

[misc]
  # Privacy level (0 = show everything in logs)
  privacylevel = 0

[debug]
  # All debug options disabled by default
