# Network Bufferbloat Mitigation Settings
# Optimized for low-latency networking on Pimeleon Router
# Ported from working gw configuration

# Kernel logging (reduce spam)
kernel.printk = 3 4 1 3

# Memory management
vm.min_free_kbytes = 16384

# Allow ping from any group
net.ipv4.ping_group_range = 0 2147483647

# Network device queue settings (high throughput)
net.core.netdev_max_backlog = 30000
net.core.netdev_budget = 600
net.core.dev_weight = 64

# Large socket buffers for throughput
net.core.rmem_default = 1048576
net.core.rmem_max = 4194304
net.core.wmem_default = 1048576
net.core.wmem_max = 4194304

# IP forwarding
net.ipv4.ip_forward = 1
net.ipv4.conf.all.forwarding = 1

# Disable reverse path filtering for LAN interfaces (required for routing)
net.ipv4.conf.all.rp_filter = 0

# IPv6 settings
net.ipv6.conf.default.disable_ipv6 = 0
net.ipv6.conf.all.disable_ipv6 = 0
net.ipv6.conf.all.forwarding = 1

# Security hardening
fs.protected_hardlinks = 1
fs.protected_symlinks = 1
