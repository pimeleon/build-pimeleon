# Hostapd Configuration - Generated by Pimeleon Build

# Basic AP settings
interface={{ wifi_interface | default('wlan0') }}
driver=nl80211
ssid={{ pimeleon_ap_name | default('Pimeleon') }}
wpa_passphrase={{ wifi_passphrase | default('changeme123') }}
country_code={{ wifi_country_code | default('US') }}
# Disable 802.11d to prevent COUNTRY_UPDATE state cycling
ieee80211d=0

# Channel and mode
hw_mode={{ wifi_hw_mode | default('g') }}
channel={{ wifi_channel | default(6) }}

# WPA2 configuration
wpa=2
auth_algs=1
wpa_key_mgmt=WPA-PSK
wpa_pairwise=TKIP CCMP
rsn_pairwise=CCMP

# MAC address ACL (0 = accept all)
macaddr_acl=0

# QoS / WMM
wmm_enabled=1

# Maximum stations
max_num_sta={{ hostapd_max_sta | default(256) }}

# Logging
logger_syslog=1
logger_syslog_level={{ hostapd_log_level | default(2) }}
logger_stdout=1
logger_stdout_level={{ hostapd_log_level | default(2) }}

# 802.11n support
ieee80211n=1
{% if hostapd_require_ht | default(false) %}
require_ht=1
{% if hostapd_ht_enabled | default(false) %}
ht_capab={{ hostapd_ht_capab }}
{% endif %}
{% endif %}

{% if hostapd_vht_enabled | default(false) %}
# 802.11ac (VHT) support - Pi 4 only
ieee80211ac=1
{% if hostapd_vht_capab is defined %}
vht_capab={{ hostapd_vht_capab }}
{% endif %}
vht_oper_chwidth=1
{% endif %}

# WPS Configuration - disabled for security (vulnerable to brute-force)
#wps_state={{ hostapd_wps_state | default(0) }}
#wps_pin_requests=/run/hostapd_wps_pin_requests
#device_name={{ pimeleon_ap_name | default('Pimeleon') }} WPS
#manufacturer=Pimeleon
#model_number=1

# iOS/Mobile Compatibility Settings
beacon_int={{ hostapd_beacon_int | default(200) }}
dtim_period={{ hostapd_dtim_period | default(2) }}
disassoc_low_ack=0
ap_max_inactivity={{ hostapd_ap_max_inactivity | default(600) }}
skip_inactivity_poll=1

# Stability settings
wpa_group_rekey={{ hostapd_wpa_group_rekey | default(3600) }}
wpa_strict_rekey=0

{% if hostapd_ap_isolate | default(false) %}
# Client isolation (prevents client-to-client traffic)
ap_isolate=1
{% endif %}
