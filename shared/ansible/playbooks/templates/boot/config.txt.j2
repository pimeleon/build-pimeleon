# Pimeleon boot configuration
# {{ ansible_managed }}
# Platform: {{ platform_model | default('unknown') }}
#
# For more options and information see
# http://rpf.io/configtxt
# Some settings may impact device functionality. See link above for details
# and ensure compatibility with your specific Raspberry Pi model.

# uncomment if you get no picture on HDMI for a default "safe" mode
#hdmi_safe=1

# uncomment this if your display has a black border of unused pixels visible
# and your display can output without overscan
#disable_overscan=1

# GPU memory (16MB minimum for headless, 64MB if HDMI debugging needed)
gpu_mem={{ config_txt.gpu_mem | default(16) }}

# uncomment the following to adjust overscan. Use positive numbers if console
# goes off screen, and negative if there is too much border
overscan_left=16
overscan_right=16
#overscan_top=16
#overscan_bottom=16

# uncomment to force a console size. By default it will be display's size minus
# overscan.
#framebuffer_width=1280
#framebuffer_height=720

# uncomment if hdmi display is not detected and composite is being output
hdmi_force_hotplug=1

# force a HDMI mode rather than DVI for better monitor compatibility
hdmi_drive=2

# increase signal to HDMI to prevent blanking
config_hdmi_boost=4

# CPU frequency
arm_freq={{ config_txt.arm_freq | default(1200) }}
{% if config_txt.over_voltage is defined %}
over_voltage={{ config_txt.over_voltage }}
{% endif %}

# UART for serial console debugging
enable_uart={{ config_txt.enable_uart | default(1) }}

# Essential hardware interfaces
dtparam=i2c_arm={{ config_txt.dtparam_i2c | default('on') }}
dtparam=spi=o{{ config_txt.dtparam_spi | default('on') }}

# Additional overlays
{% for overlay in device_tree_overlays | default([]) %}
dtoverlay={{ overlay | regex_replace('\.dtbo$', '') }}
{% endfor %}

# Disable all multimedia and camera features
dtparam=audio=off
start_x=0

# USB power configuration
{% if config_txt.max_usb_current is defined %}
max_usb_current={{ config_txt.max_usb_current }}
{% endif %}
