# Squid Proxy Configuration for Pimeleon
# Managed by Ansible - do not edit manually

# Hostname (required)
visible_hostname {{ hostname | default('pimeleon') }}

# ACL definitions - use CIDR only, no overlapping entries
acl localnet src 10.0.0.0/8
acl localnet src 172.16.0.0/12
acl localnet src 192.168.0.0/16
acl localnet src fc00::/7
acl localnet src fe80::/10

acl ftp proto FTP
acl Safe_ports port 80
acl Safe_ports port 21
acl Safe_ports port 443
acl Safe_ports port 70
acl Safe_ports port 210
acl Safe_ports port 280
acl Safe_ports port 488
acl Safe_ports port 591
acl Safe_ports port 777
acl Safe_ports port 1025-65535
acl SSL_ports port 443
acl CONNECT method CONNECT

# Access control
http_access deny !Safe_ports
http_access allow localhost
http_access allow localnet
http_access deny all

icp_access deny all
htcp_access allow all

# HTTP ports
http_port 127.0.0.1:{{ squid_http_port }}
http_port {{ default_ip }}:{{ squid_http_port }}
http_port 127.0.0.1:{{ squid_transparent_port }} transparent
http_port {{ default_ip }}:{{ squid_transparent_port }} transparent

# HTTPS ports with SSL bumping
https_port 127.0.0.1:{{ squid_https_port }} transparent ssl-bump cert=/etc/squid/ssl_cert/myCA.pem generate-host-certificates=on dynamic_cert_mem_cache_size=4MB options=ALL connection-auth=off
https_port {{ default_ip }}:{{ squid_https_port }} transparent ssl-bump cert=/etc/squid/ssl_cert/myCA.pem generate-host-certificates=on dynamic_cert_mem_cache_size=4MB options=ALL connection-auth=off

# Forward to Privoxy for ab2p filtering
cache_peer 127.0.0.1 parent 8118 7 default no-delay no-digest no-netdb-exchange no-query

# SSL bump for HTTPS content inspection
acl step1 at_step SslBump1
acl step2 at_step SslBump2
acl step3 at_step SslBump3
acl nobump_sites ssl::server_name "/etc/squid/nobump_sites.txt"

ssl_bump peek step1
ssl_bump splice nobump_sites
ssl_bump bump all

# SSL certificate generation
sslcrtd_program /lib/squid/security_file_certgen -s /var/lib/ssl_db -M 4MB
sslcrtd_children 4 startup=1 idle=1

# Cache settings
coredump_dir /var/spool/squid
cache_dir ufs /var/spool/squid 1500 32 256
cache_effective_user proxy
cache_effective_group proxy

# Routing
always_direct allow ftp
never_direct allow all

# Network settings
dns_nameservers {{ dns_local }} {{ dns_internal }}
forwarded_for delete
sslproxy_cert_error deny all

# Performance
prefer_direct off
nonhierarchical_direct off
shutdown_lifetime 5 second

# Timeouts
connect_timeout 30 seconds
read_timeout 15 seconds
request_timeout 3 minute
client_idle_pconn_timeout 2 minutes
server_idle_pconn_timeout 1 minute

# Refresh patterns
refresh_pattern ^ftp: 1440 20% 10080
refresh_pattern ^gopher: 1440 0% 1440
refresh_pattern -i (/cgi-bin/|\?) 0 0% 0
refresh_pattern (mp3|mp4|ts)$ 0 0% 0
refresh_pattern . 0 20% 4320

# Protocol handling
acl foreignProtocol squid_error ERR_PROTOCOL_UNKNOWN ERR_TOO_BIG
acl serverTalksFirstProtocol squid_error ERR_REQUEST_START_TIMEOUT
on_unsupported_protocol tunnel foreignProtocol
on_unsupported_protocol tunnel serverTalksFirstProtocol
on_unsupported_protocol respond all

# Security and logging
httpd_suppress_version_string on
error_default_language en
logfile_rotate 0
debug_options ALL,1 33,2 rotate=0

# === RPi Memory Optimizations ===
cache_mem 64 MB
maximum_object_size_in_memory 256 KB
memory_replacement_policy lru
memory_pools off
memory_pools_limit 32 MB
max_filedescriptors 4096
workers 1

# === Cache Optimizations ===
quick_abort_min 0 KB
quick_abort_max 0 KB
negative_ttl 1 minute
positive_dns_ttl 6 hours
negative_dns_ttl 1 minute
