# Avahi daemon configuration
# Pimeleon mDNS/DNS-SD configuration

[server]
host-name={{ inventory_hostname | default('pimeleon') }}
domain-name=local
use-ipv4=yes
use-ipv6=yes
allow-interfaces={{ lan_interface }},{{ wifi_interface | default('wlan0') }}
deny-interfaces={{ wan_interface }}
ratelimit-interval-usec=1000000
ratelimit-burst=1000

[wide-area]
enable-wide-area=no

[publish]
publish-hinfo=no
publish-workstation=no
publish-domain=yes
publish-resolv-conf-dns-servers=no
publish-aaaa-on-ipv4=no
publish-a-on-ipv6=no

[reflector]
enable-reflector=no
reflect-ipv=no

[rlimits]
rlimit-core=0
rlimit-data=4194304
rlimit-fsize=0
rlimit-nofile=768
rlimit-stack=4194304
rlimit-nproc=3
