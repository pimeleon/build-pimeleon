# Privoxy configuration

confdir /etc/privoxy
logdir /var/log/privoxy

# Action and filter files
actionsfile match-all.action
actionsfile default.action
actionsfile user.action
filterfile default.filter
filterfile user.filter

# AdBlock Plus converted filters (generated by adblock2privoxy)
actionsfile ab2p/ab2p.system.action
actionsfile ab2p/ab2p.action
filterfile ab2p/ab2p.system.filter
filterfile ab2p/ab2p.filter

# ads.yoyo.org domain blocklist
actionsfile ads.yoyo.action

logfile logfile

# Debug level (1024 = log blocked requests)
debug 1024

user-manual /usr/share/doc/privoxy/user-manual

# Listen on localhost and LAN interfaces
listen-address 127.0.0.1:{{ privoxy_port | default(8118) }}
listen-address {{ wifi_ap_ip }}:{{ privoxy_port | default(8118) }}

toggle 1

# Remote management (from LAN only via firewall)
enable-remote-toggle 1
enable-edit-actions 1
enable-remote-http-toggle 1

buffer-limit 4096

# Accept intercepted (transparent proxy) requests
accept-intercepted-requests 1

forwarded-connect-retries 0
allow-cgi-request-crunching 0
split-large-forms 0
handle-as-empty-doc-returns-ok 1

keep-alive-timeout 60
socket-timeout 300

enable-proxy-authentication-forwarding 0

# Direct connections (no upstream proxy)
forward / .
