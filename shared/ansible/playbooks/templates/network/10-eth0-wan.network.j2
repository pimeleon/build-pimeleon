# WAN interface configuration
# Generated by Pimeleon Build

[Match]
Name={{ wan_interface | default('eth0') }}

[Network]
DHCP=yes
{% if ipv6_enabled | default(true) %}
IPv6AcceptRA=yes
{% endif %}

[DHCPv4]
UseDNS=no
UseRoutes=yes

{% if ipv6_enabled | default(true) %}
[DHCPv6]
UseNTP=no
UseDNS=no
{% endif %}
