# LAN interface configuration (SECONDARY - requires USB adapter)
# Generated by Pimeleon Build

[Match]
Name={{ lan_interface | default('eth1') }}

[Network]
Address={{ lan_ip | default('192.168.43.1') }}/{{ lan_netmask_cidr | default('24') }}
{% if ipv6_enabled | default(true) %}
Address={{ lan_ipv6 | default('fd00:1:43::1') }}/64
IPForward=ipv6
{% endif %}
