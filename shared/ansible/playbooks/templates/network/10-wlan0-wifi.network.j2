# WiFi AP interface configuration (PRIMARY LAN)
# Generated by Pimeleon Build

[Match]
Name={{ wifi_interface | default('wlan0') }}

[Network]
Address={{ wifi_ap_ip | default('192.168.42.1') }}/{{ wifi_ap_netmask_cidr | default('24') }}
{% if ipv6_enabled | default(true) %}
Address={{ wifi_ipv6 | default('fd00:1:42::1') }}/64
IPForward=ipv6
{% endif %}
RequiredForOnline=routable
