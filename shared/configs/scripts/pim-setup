#!/bin/bash
#
# pim-setup - First Boot Setup Wizard for Pimeleon Router
# Runs automatically on first boot to configure basic network settings
#

set -euo pipefail

# Constants
VERSION="1.0.0"
SETUP_DONE_MARKER="/var/lib/pimeleon/.setup-complete"
LOG_FILE="/var/log/pimeleon/setup.log"

# Colors for non-whiptail output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

# Ensure log directory exists
mkdir -p "$(dirname "$LOG_FILE")"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"
    echo -e "$1"
}

log_info() {
    log "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    log "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    log "${RED}[ERROR]${NC} $1"
}

# Check for root
check_root() {
    if [[ $EUID -ne 0 ]]; then
        echo -e "${RED}Error: This script must be run as root${NC}"
        echo "Try: sudo pim-setup"
        exit 1
    fi
}

# Check for whiptail
check_whiptail() {
    if ! command -v whiptail &>/dev/null; then
        echo -e "${RED}Error: whiptail not found${NC}"
        exit 1
    fi
}

# Calculate terminal size
calc_wt_size() {
    WT_HEIGHT=22
    WT_WIDTH=76
    WT_MENU_HEIGHT=$((WT_HEIGHT - 10))
}

#=============================================================================
# Network Detection
#=============================================================================

detect_interfaces() {
    IFACES_WLAN=()
    IFACES_ETH=()

    for iface in /sys/class/net/*; do
        iface_name=$(basename "$iface")
        [[ "$iface_name" == "lo" ]] && continue

        if [[ -d "$iface/wireless" ]]; then
            IFACES_WLAN+=("$iface_name")
        elif [[ "$iface_name" =~ ^eth ]]; then
            IFACES_ETH+=("$iface_name")
        fi
    done

    log_info "Detected WiFi interfaces: ${IFACES_WLAN[*]:-none}"
    log_info "Detected Ethernet interfaces: ${IFACES_ETH[*]:-none}"
}

has_extra_interfaces() {
    # Check if user has wlan1 or other additional WiFi interfaces
    [[ ${#IFACES_WLAN[@]} -gt 1 ]]
}

#=============================================================================
# Common Configuration Functions
#=============================================================================

prompt_wifi_credentials() {
    local default_ssid="${1:-Pimeleon}"

    WIFI_SSID=$(whiptail --inputbox "Enter WiFi network name (SSID):" 8 60 "$default_ssid" 3>&1 1>&2 2>&3) || return 1

    if [[ -z "$WIFI_SSID" ]]; then
        whiptail --msgbox "SSID cannot be empty" 8 40
        return 1
    fi

    WIFI_PASS=$(whiptail --passwordbox "Enter WiFi password (min 8 characters):" 8 60 3>&1 1>&2 2>&3) || return 1

    if [[ ${#WIFI_PASS} -lt 8 ]]; then
        whiptail --msgbox "Password must be at least 8 characters" 8 40
        return 1
    fi

    # Confirm password
    local confirm_pass
    confirm_pass=$(whiptail --passwordbox "Confirm WiFi password:" 8 60 3>&1 1>&2 2>&3) || return 1

    if [[ "$WIFI_PASS" != "$confirm_pass" ]]; then
        whiptail --msgbox "Passwords do not match" 8 40
        return 1
    fi

    return 0
}

prompt_wifi_country() {
    WIFI_COUNTRY=$(whiptail --title "WiFi Country Code" --menu \
        "Select your country for WiFi regulatory compliance:" \
        $WT_HEIGHT $WT_WIDTH $WT_MENU_HEIGHT \
        "US" "United States" \
        "GB" "United Kingdom" \
        "DE" "Germany" \
        "FR" "France" \
        "UA" "Ukraine" \
        "PL" "Poland" \
        "IE" "Ireland" \
        "NL" "Netherlands" \
        "JP" "Japan" \
        "AU" "Australia" \
        "CA" "Canada" \
        "Other" "Enter custom code" \
        3>&1 1>&2 2>&3) || return 1

    if [[ "$WIFI_COUNTRY" == "Other" ]]; then
        WIFI_COUNTRY=$(whiptail --inputbox "Enter 2-letter country code (ISO 3166-1):" 8 50 "US" 3>&1 1>&2 2>&3) || return 1
    fi

    WIFI_COUNTRY=$(echo "$WIFI_COUNTRY" | tr '[:lower:]' '[:upper:]')

    if [[ -z "$WIFI_COUNTRY" || ${#WIFI_COUNTRY} -ne 2 ]]; then
        whiptail --msgbox "Invalid country code" 8 40
        return 1
    fi

    return 0
}

prompt_wifi_channel() {
    WIFI_CHANNEL=$(whiptail --title "WiFi Channel" --menu \
        "Select WiFi channel (2.4GHz):" \
        $WT_HEIGHT $WT_WIDTH $WT_MENU_HEIGHT \
        "6" "Channel 6 (2437 MHz) - Recommended" \
        "1" "Channel 1 (2412 MHz)" \
        "11" "Channel 11 (2462 MHz)" \
        "auto" "Auto-select best channel" \
        3>&1 1>&2 2>&3) || return 1

    [[ "$WIFI_CHANNEL" == "auto" ]] && WIFI_CHANNEL="0"

    return 0
}

prompt_timezone() {
    TIMEZONE=$(whiptail --title "Timezone" --menu \
        "Select your timezone:" \
        $WT_HEIGHT $WT_WIDTH $WT_MENU_HEIGHT \
        "UTC" "Coordinated Universal Time" \
        "Europe/London" "London, UK" \
        "Europe/Paris" "Paris, France" \
        "Europe/Berlin" "Berlin, Germany" \
        "Europe/Kyiv" "Kyiv, Ukraine" \
        "Europe/Warsaw" "Warsaw, Poland" \
        "America/New_York" "New York, USA" \
        "America/Los_Angeles" "Los Angeles, USA" \
        "Asia/Tokyo" "Tokyo, Japan" \
        "Other" "Enter custom timezone" \
        3>&1 1>&2 2>&3) || return 1

    if [[ "$TIMEZONE" == "Other" ]]; then
        TIMEZONE=$(whiptail --inputbox "Enter timezone (e.g., Europe/Rome):" 8 50 "UTC" 3>&1 1>&2 2>&3) || return 1
    fi

    return 0
}

prompt_admin_password() {
    whiptail --msgbox "For security, you should change the default password for the 'pim' user.\n\nYou will be prompted to enter a new password." 10 60

    if passwd pim; then
        log_info "Password changed successfully"
        return 0
    else
        log_error "Failed to change password"
        return 1
    fi
}

prompt_lan_config() {
    # For Option 2: Configure eth0 as LAN server
    LAN_IP=$(whiptail --inputbox "Enter LAN IP address for eth0:" 8 60 "192.168.42.1" 3>&1 1>&2 2>&3) || return 1
    LAN_NETMASK=$(whiptail --inputbox "Enter LAN netmask:" 8 60 "255.255.255.0" 3>&1 1>&2 2>&3) || return 1
    LAN_DOMAIN=$(whiptail --inputbox "Enter local domain name:" 8 60 "local.lan" 3>&1 1>&2 2>&3) || return 1

    # DHCP range
    local ip_prefix="${LAN_IP%.*}"
    DHCP_START=$(whiptail --inputbox "Enter DHCP range start:" 8 60 "${ip_prefix}.100" 3>&1 1>&2 2>&3) || return 1
    DHCP_END=$(whiptail --inputbox "Enter DHCP range end:" 8 60 "${ip_prefix}.254" 3>&1 1>&2 2>&3) || return 1

    return 0
}

prompt_upstream_wifi() {
    # For Option 2: Configure wlan0 as client
    whiptail --msgbox "Configure WiFi to connect to your upstream network.\n\nThis will be used for internet access." 10 60

    UPSTREAM_SSID=$(whiptail --inputbox "Enter upstream WiFi network name (SSID):" 8 60 3>&1 1>&2 2>&3) || return 1

    if [[ -z "$UPSTREAM_SSID" ]]; then
        whiptail --msgbox "SSID cannot be empty" 8 40
        return 1
    fi

    UPSTREAM_PASS=$(whiptail --passwordbox "Enter upstream WiFi password:" 8 60 3>&1 1>&2 2>&3) || return 1

    return 0
}

#=============================================================================
# Configuration Application Functions
#=============================================================================

apply_ap_mode_config() {
    log_info "Applying AP mode configuration..."

    # Configure hostapd
    if [[ -f /etc/hostapd/hostapd.conf ]]; then
        sed -i "s/^ssid=.*/ssid=$WIFI_SSID/" /etc/hostapd/hostapd.conf
        sed -i "s/^wpa_passphrase=.*/wpa_passphrase=$WIFI_PASS/" /etc/hostapd/hostapd.conf
        sed -i "s/^country_code=.*/country_code=$WIFI_COUNTRY/" /etc/hostapd/hostapd.conf
        sed -i "s/^channel=.*/channel=$WIFI_CHANNEL/" /etc/hostapd/hostapd.conf
        log_info "hostapd.conf updated"
    else
        log_error "hostapd.conf not found"
        return 1
    fi

    # Set regulatory domain
    iw reg set "$WIFI_COUNTRY" 2>/dev/null || true

    # Configure eth0 as WAN (DHCP client)
    cat > /etc/systemd/network/10-eth0.network <<EOF
# WAN interface - DHCP client
# Generated by pim-setup

[Match]
Name=eth0

[Network]
DHCP=yes
IPv6AcceptRA=yes

[DHCPv4]
UseDNS=no
UseRoutes=yes
EOF

    # Ensure wpa_supplicant is disabled
    systemctl stop wpa_supplicant 2>/dev/null || true
    systemctl disable wpa_supplicant 2>/dev/null || true
    systemctl mask wpa_supplicant 2>/dev/null || true

    # Enable hostapd
    systemctl unmask hostapd 2>/dev/null || true
    systemctl enable hostapd

    log_info "AP mode configuration applied"
    return 0
}

apply_client_mode_config() {
    log_info "Applying client mode configuration..."

    # Create wpa_supplicant config for wlan0
    mkdir -p /etc/wpa_supplicant
    cat > /etc/wpa_supplicant/wpa_supplicant-wlan0.conf <<EOF
ctrl_interface=DIR=/var/run/wpa_supplicant GROUP=netdev
update_config=1
country=$WIFI_COUNTRY

network={
    ssid="$UPSTREAM_SSID"
    psk="$UPSTREAM_PASS"
    key_mgmt=WPA-PSK
}
EOF
    chmod 600 /etc/wpa_supplicant/wpa_supplicant-wlan0.conf

    # Configure wlan0 as DHCP client
    cat > /etc/systemd/network/10-wlan0-client.network <<EOF
# WiFi client interface
# Generated by pim-setup

[Match]
Name=wlan0

[Network]
DHCP=yes
IPv6AcceptRA=yes

[DHCPv4]
UseDNS=yes
UseRoutes=yes
EOF

    # Configure eth0 as LAN server with static IP
    cat > /etc/systemd/network/10-eth0-lan.network <<EOF
# LAN interface - Static IP for DHCP/DNS server
# Generated by pim-setup

[Match]
Name=eth0

[Network]
Address=${LAN_IP}/24
IPForward=yes
EOF

    # Update DHCP server config
    if [[ -f /etc/dhcp/dhcpd.conf ]]; then
        # Update subnet configuration
        local ip_prefix="${LAN_IP%.*}"
        cat > /etc/dhcp/dhcpd.conf <<EOF
# DHCP Server Configuration
# Generated by pim-setup

authoritative;
default-lease-time 600;
max-lease-time 7200;

option domain-name "${LAN_DOMAIN}";
option domain-name-servers ${LAN_IP};

subnet ${ip_prefix}.0 netmask ${LAN_NETMASK} {
    range ${DHCP_START} ${DHCP_END};
    option routers ${LAN_IP};
    option subnet-mask ${LAN_NETMASK};
    option broadcast-address ${ip_prefix}.255;
    option domain-name-servers ${LAN_IP};
}
EOF
        log_info "dhcpd.conf updated"
    fi

    # Configure DHCP server to listen on eth0 only
    if [[ -f /etc/default/isc-dhcp-server ]]; then
        sed -i 's/^INTERFACESv4=.*/INTERFACESv4="eth0"/' /etc/default/isc-dhcp-server
    fi

    # Disable hostapd
    systemctl stop hostapd 2>/dev/null || true
    systemctl disable hostapd 2>/dev/null || true

    # Enable wpa_supplicant
    systemctl unmask wpa_supplicant 2>/dev/null || true
    systemctl enable wpa_supplicant@wlan0

    log_info "Client mode configuration applied"
    return 0
}

apply_timezone() {
    if timedatectl set-timezone "$TIMEZONE" 2>/dev/null; then
        log_info "Timezone set to: $TIMEZONE"
        return 0
    else
        log_error "Failed to set timezone"
        return 1
    fi
}

restart_services() {
    log_info "Restarting network services..."

    if [[ -n "${SSH_CONNECTION:-}" ]]; then
        whiptail --title "SSH Connection Warning" --msgbox \
            "You are connected via SSH. Restarting network services may cause a temporary disconnect.\n\nIf you lose connection, please wait a moment and then log back in to see the completion message." 12 60
    fi

    whiptail --infobox "Applying configuration and restarting services...\n\nThis may take a moment." 8 50

    systemctl daemon-reload
    systemctl restart systemd-networkd

    sleep 2

    # Restart mode-specific services
    if systemctl is-enabled hostapd &>/dev/null; then
        systemctl restart hostapd || log_warn "Failed to restart hostapd"
    fi

    if systemctl is-enabled wpa_supplicant@wlan0 &>/dev/null; then
        systemctl restart wpa_supplicant@wlan0 || log_warn "Failed to restart wpa_supplicant"
    fi

    if systemctl is-enabled isc-dhcp-server &>/dev/null; then
        systemctl restart isc-dhcp-server || log_warn "Failed to restart DHCP server"
    fi

    if systemctl is-enabled bind9 &>/dev/null; then
        systemctl restart bind9 || log_warn "Failed to restart DNS server"
    fi

    sleep 2
    log_info "Services restarted"
}

#=============================================================================
# Setup Options
#=============================================================================

setup_option_1() {
    # Option 1: AP on wlan0, WAN DHCP on eth0
    whiptail --title "Option 1: Access Point Mode" --msgbox \
        "This will configure your Pimeleon as a WiFi Access Point:\n\n\
• wlan0: WiFi Access Point (devices connect here)\n\
• eth0: WAN connection via DHCP (to your ISP/modem)\n\n\
You will need to configure:\n\
• WiFi network name (SSID)\n\
• WiFi password\n\
• WiFi country code\n\
• Timezone" 16 65

    # Collect configuration
    prompt_wifi_credentials "Pimeleon" || return 1
    prompt_wifi_country || return 1
    prompt_wifi_channel || return 1
    prompt_timezone || return 1

    # Show summary
    if ! whiptail --title "Confirm Configuration" --yesno \
        "Please confirm your settings:\n\n\
WiFi SSID: $WIFI_SSID\n\
WiFi Country: $WIFI_COUNTRY\n\
WiFi Channel: $WIFI_CHANNEL\n\
Timezone: $TIMEZONE\n\n\
eth0 will use DHCP to get internet.\n\n\
Apply this configuration?" 18 60; then
        return 1
    fi

    # Apply configuration
    apply_ap_mode_config || return 1
    apply_timezone || return 1

    # Change password
    if whiptail --yesno "Do you want to change the default password now?\n\n(Recommended for security)" 10 50; then
        prompt_admin_password
    fi

    restart_services

    # Get assigned IPs
    local wan_ip=$(ip -4 addr show eth0 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' || echo "Obtaining...")
    local lan_ip=$(ip -4 addr show wlan0 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' || echo "192.168.42.1")

    whiptail --title "Setup Complete!" --msgbox \
        "Access Point mode configured successfully!\n\n\
WiFi Network: $WIFI_SSID\n\
WiFi Password: (as configured)\n\n\
WAN IP (eth0): $wan_ip\n\
LAN Gateway (wlan0): $lan_ip\n\n\
Web UI: http://${lan_ip}\n\n\
Connect your devices to '$WIFI_SSID' to use the network." 18 60

    return 0
}

setup_option_2() {
    # Option 2: WiFi client on wlan0, LAN server on eth0
    whiptail --title "Option 2: WiFi Client + LAN Server" --msgbox \
        "This will configure your Pimeleon as a WiFi client with LAN:\n\n\
• wlan0: WiFi Client (connects to existing WiFi)\n\
• eth0: LAN server with DHCP/DNS for connected devices\n\n\
Use this when you want to:\n\
• Connect to existing WiFi for internet\n\
• Provide network to devices via ethernet (e.g., switch)\n\n\
You will need to configure:\n\
• Upstream WiFi network credentials\n\
• LAN IP address and DHCP settings" 18 68

    # Collect configuration
    prompt_wifi_country || return 1
    prompt_upstream_wifi || return 1
    prompt_lan_config || return 1
    prompt_timezone || return 1

    # Show summary
    if ! whiptail --title "Confirm Configuration" --yesno \
        "Please confirm your settings:\n\n\
Upstream WiFi: $UPSTREAM_SSID\n\
WiFi Country: $WIFI_COUNTRY\n\n\
LAN IP (eth0): $LAN_IP\n\
LAN Domain: $LAN_DOMAIN\n\
DHCP Range: $DHCP_START - $DHCP_END\n\n\
Timezone: $TIMEZONE\n\n\
Apply this configuration?" 20 60; then
        return 1
    fi

    # Apply configuration
    apply_client_mode_config || return 1
    apply_timezone || return 1

    # Change password
    if whiptail --yesno "Do you want to change the default password now?\n\n(Recommended for security)" 10 50; then
        prompt_admin_password
    fi

    restart_services

    whiptail --title "Setup Complete!" --msgbox \
        "WiFi Client + LAN Server mode configured!\n\n\
Connecting to: $UPSTREAM_SSID\n\
LAN Gateway: $LAN_IP\n\
LAN Domain: $LAN_DOMAIN\n\n\
Web UI: http://${LAN_IP}\n\n\
Connect devices to eth0 port (directly or via switch)." 16 60

    return 0
}

setup_option_3() {
    # Option 3: Advanced - has extra WiFi interfaces
    local extra_info=""
    [[ ${#IFACES_WLAN[@]} -gt 1 ]] && extra_info+="• Extra WiFi: ${IFACES_WLAN[*]:1}\n"

    whiptail --title "Option 3: Advanced Configuration" --msgbox \
        "Additional WiFi interfaces detected:\n\n\
${extra_info}\n\
For multi-interface setups, we recommend:\n\n\
1. Complete basic setup (Option 1 or 2) first\n\
2. Then configure additional interfaces via Web UI\n\n\
This ensures your Pimeleon has network connectivity\n\
for web-based configuration." 18 65

    local choice
    choice=$(whiptail --title "Advanced Setup" --menu \
        "Choose how to proceed:" \
        $WT_HEIGHT $WT_WIDTH $WT_MENU_HEIGHT \
        "1" "Start with AP Mode (Option 1), configure extras via Web UI" \
        "2" "Start with Client Mode (Option 2), configure extras via Web UI" \
        "3" "Skip setup - configure everything manually later" \
        3>&1 1>&2 2>&3) || return 1

    case "$choice" in
        1)
            if setup_option_1; then
                show_webui_info
            fi
            ;;
        2)
            if setup_option_2; then
                show_webui_info
            fi
            ;;
        3)
            whiptail --msgbox \
                "Setup skipped.\n\n\
You can run this wizard again with:\n\
  sudo pim-setup\n\n\
Or use the configuration utility:\n\
  sudo pim-config\n\n\
Default credentials:\n\
  User: pim\n\
  Password: (check documentation)" 16 55
            ;;
    esac

    return 0
}

show_webui_info() {
    local ip=""

    # Try to get a valid IP
    for iface in wlan0 eth0; do
        ip=$(ip -4 addr show "$iface" 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -1)
        [[ -n "$ip" ]] && break
    done

    [[ -z "$ip" ]] && ip="<device-ip>"

    whiptail --title "Web UI Access" --msgbox \
        "Basic setup complete!\n\n\
Access the Web UI:\n\n\
  http://${ip}\n\n\
Or use SSH:\n\
  ssh pim@${ip}\n\n\
Then run: sudo pim-config" 16 55
}

#=============================================================================
# Main Menu
#=============================================================================

show_welcome() {
    if ! whiptail --title "Welcome to Pimeleon Setup" --yesno \
        "Welcome to Pimeleon Router!\n\n\
This wizard will help you configure your router for first use.\n\n\
Version: $VERSION\n\n\
Press [Yes] to continue or [No] to exit." 14 55; then
        log_info "User exited from welcome screen"
        clear
        echo -e "${GREEN}Pimeleon Setup${NC}"
        echo ""
        echo "You can run this wizard again with: sudo pim-setup"
        echo "Or configure manually with: sudo pim-config"
        echo ""
        exit 0
    fi
}

main_menu() {
    detect_interfaces

    local menu_items=()
    local has_extra=false

    # Always show options 1 and 2
    menu_items+=("1" "AP Mode: WiFi Access Point + WAN on eth0 (Recommended)")
    menu_items+=("2" "Client Mode: Connect to WiFi + LAN server on eth0")

    # Show option 3 if extra WiFi interfaces detected
    if has_extra_interfaces; then
        has_extra=true
        menu_items+=("3" "Advanced: Configure additional WiFi interfaces")
    fi

    local choice
    choice=$(whiptail --title "Pimeleon Setup - Network Mode" --menu \
        "Select your network configuration:\n\n\
Detected interfaces:\n\
  WiFi: ${IFACES_WLAN[*]:-none}\n\
  Ethernet: ${IFACES_ETH[*]:-none}" \
        $WT_HEIGHT $WT_WIDTH $WT_MENU_HEIGHT \
        "${menu_items[@]}" \
        3>&1 1>&2 2>&3) || return 1

    case "$choice" in
        1) setup_option_1 ;;
        2) setup_option_2 ;;
        3) setup_option_3 ;;
    esac

    return $?
}

mark_setup_complete() {
    mkdir -p "$(dirname "$SETUP_DONE_MARKER")"
    touch "$SETUP_DONE_MARKER"
    log_info "Setup marked as complete"
}

#=============================================================================
# Main Entry Point
#=============================================================================

main() {
    # Ignore Ctrl+C to prevent accidental exit
    trap '' INT

    check_root
    check_whiptail
    calc_wt_size

    log_info "Starting Pimeleon Setup Wizard v$VERSION"

    # Check if already completed
    if [[ -f "$SETUP_DONE_MARKER" ]]; then
        if ! whiptail --yesno "Setup has already been completed.\n\nDo you want to run it again?" 10 50; then
            log_info "Setup already complete, user declined to re-run"
            exit 0
        fi
    fi

    show_welcome

    if main_menu; then
        mark_setup_complete
        log_info "Setup completed successfully"

        if whiptail --yesno "Setup complete!\n\nWould you like to reboot now to apply all changes?" 10 50; then
            log_info "Rebooting..."
            reboot
        fi
    else
        log_warn "Setup was cancelled or failed"

        whiptail --msgbox "Setup was not completed.\n\nYou can run this wizard again with:\n  sudo pim-setup\n\nOr configure manually with:\n  sudo pim-config" 12 50
    fi

    clear
    echo -e "${GREEN}Pimeleon Setup Complete${NC}"
    echo ""
    echo "Run 'sudo pim-config' for additional configuration."
    echo ""
}

# Allow running specific functions for testing
if [[ "${1:-}" == "--test" ]]; then
    shift
    "$@"
else
    main "$@"
fi
